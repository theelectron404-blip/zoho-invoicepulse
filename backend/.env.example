# =============================================================================
#  InvoicePulse — Zoho Books Integration Environment Variables
# =============================================================================

# 1. Zoho API Console Credentials (https://api-console.zoho.com)
ZOHO_CLIENT_ID=1000.XXXXXXXXXXXXXXXXXXXXXXXXXXXX
ZOHO_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 2. Redirect URI registered in your Zoho Developer Console Client
ZOHO_REDIRECT_URI=http://localhost:8000/auth/callback

# 3. Zoho Data Center Domains
# Options:
#   US: https://accounts.zoho.com    / https://www.zohoapis.com
#   EU: https://accounts.zoho.eu     / https://www.zohoapis.eu
#   IN: https://accounts.zoho.in     / https://www.zohoapis.in
#   AU: https://accounts.zoho.com.au / https://www.zohoapis.com.au
ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.com
ZOHO_API_DOMAIN=https://www.zohoapis.com

# 4. Zoho Books Organization ID (From your Books URL or settings)
ZOHO_ORGANIZATION_ID=892348102

# 5. Dispatch Engine Throttling Configuration
# Delay in seconds between requests to protect against Zoho rate limits (e.g. 0.1s - 0.5s)
BATCH_DELAY_SECONDS=0.08
DISPATCH_RATE_LIMIT=60

# 6. Server Host / Port
HOST=0.0.0.0
PORT=8000
